---
// Las piezas del disfraz que van dentro del dibujo de la casa (y alguna de
// otras páginas). Cada <Encantada parte="…" /> se pone en el sitio exacto del
// SVG donde tiene que quedar: delante o detrás de lo que toca, y dentro del
// grupo que se mueve con ella en el móvil.
//
// Fuera de Halloween no se ven: halloween.css las oculta todas (.hw).
import { t, type Idioma } from '../i18n/config';
import { textosHalloween as H } from './textos';

interface Props {
    parte:
        | 'defs' | 'cielo' | 'tumbas' | 'atico' | 'murcielagos' | 'arana'
        | 'puerta' | 'ventana' | 'calabaza' | 'botella' | 'calabaza-botella'
        | 'burbujas' | 'gato' | 'niebla' | 'ticket';
    idioma?: Idioma;
}

const { parte, idioma = 'es' } = Astro.props;

// Un murciélago de 40 de ancho, centrado en el origen
const murcielago = 'M0,-3 C2,-8 4,-8 5,-5 C9,-10 15,-10 20,-6 C17,-5 16,-2 17,1 C14,-1 11,0 10,3 C8,1 6,1 4,3 C3,2 1,2 0,4 C-1,2 -3,2 -4,3 C-6,1 -8,1 -10,3 C-11,0 -14,-1 -17,1 C-16,-2 -17,-5 -20,-6 C-15,-10 -9,-10 -5,-5 C-4,-8 -2,-8 0,-3 Z';
---

{parte === 'defs' && (
    <defs>
        <path id="hw-murcielago" d={murcielago} />
        <radialGradient id="hw-halo-luna">
            <stop offset="0%" stop-color="#FFE9B0" stop-opacity="0.45" />
            <stop offset="45%" stop-color="#FFB45C" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#FFB45C" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="hw-luz-vela">
            <stop offset="0%" stop-color="#FFC857" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#FF7A1A" stop-opacity="0" />
        </radialGradient>
        <filter id="hw-desenfoque" x="-20%" y="-50%" width="140%" height="200%">
            <feGaussianBlur stdDeviation="7" />
        </filter>
        <clipPath id="hw-recorte-ventana">
            <rect x="470" y="300" width="50" height="50" />
        </clipPath>
        <clipPath id="hw-recorte-puerta">
            <path d="M 380,420 L 380,340 A 25 25 0 0 1 430,340 L 430,420 Z" />
        </clipPath>
    </defs>
)}

{parte === 'cielo' && (
    <g class="hw hw-cielo" aria-hidden="true">
        <!-- Estrellas: pocas y tímidas, para que el cielo sea de noche -->
        <g class="hw-estrellas">
            {[[70, 210, 1.6], [150, 40, 1.2], [335, 60, 1.4], [372, 118, 1], [620, 52, 1.5], [690, 120, 1.1],
              [880, 60, 1.3], [860, 250, 1], [120, 300, 1.1], [600, 210, 1], [460, 40, 1.2], [20, 120, 1.3]]
              .map(([x, y, r], i) => <circle cx={x} cy={y} r={r} style={`--i:${i}`} />)}
        </g>

        <!-- La luna: se puede tocar (el aviso va en el script) -->
        <g class="hw-luna-sitio">
            <g class="hw-luna" id="hw-luna" role="button" tabindex="0" aria-label={t(H.luna, idioma)}>
                <circle r="78" fill="url(#hw-halo-luna)" class="hw-luna-halo" />
                <circle r="34" class="hw-luna-disco" />
                <circle cx="-11" cy="-8" r="7" class="hw-luna-crater" />
                <circle cx="10" cy="9" r="9" class="hw-luna-crater" />
                <circle cx="12" cy="-14" r="4" class="hw-luna-crater" />
                <circle cx="-8" cy="15" r="3.5" class="hw-luna-crater" />
            </g>
        </g>

        <!-- Murciélagos lejanos que cruzan delante de la luna -->
        <g class="hw-bandada">
            <use href="#hw-murcielago" class="hw-lejano hw-lejano-1" />
            <use href="#hw-murcielago" class="hw-lejano hw-lejano-2" />
            <use href="#hw-murcielago" class="hw-lejano hw-lejano-3" />
        </g>
    </g>
)}

{parte === 'tumbas' && (
    <g class="hw hw-tumbas" aria-hidden="true">
        <g transform="translate(118, 420) rotate(-4)">
            <path d="M -15,0 L -15,-28 A 15 15 0 0 1 15,-28 L 15,0 Z" class="hw-tumba" />
            <text y="-22" class="hw-tumba-texto">RIP</text>
            <path d="M -7,-8 L 7,-8" class="hw-tumba-raya" />
        </g>
        <g transform="translate(870, 420) rotate(5)">
            <path d="M -12,0 L -12,-30 L 12,-30 L 12,0 Z" class="hw-tumba" />
            <path d="M 0,-26 L 0,-10 M -6,-21 L 6,-21" class="hw-tumba-raya" />
        </g>
        <!-- hierbajos al pie -->
        <path d="M 96,420 l 3,-9 l 2,9 m 34,0 l 2,-7 l 3,7 M 852,420 l 2,-8 l 3,8 m 30,0 l 3,-10 l 2,10" class="hw-hierba" />
    </g>
)}

{parte === 'atico' && (
    <g class="hw hw-ojos-atico" aria-hidden="true">
        <!-- Detrás del tejado: unos ojos que parpadean en la oscuridad del ático -->
        <ellipse cx="434" cy="186" rx="5" ry="3.6" />
        <ellipse cx="466" cy="186" rx="5" ry="3.6" />
    </g>
)}

{parte === 'murcielagos' && (
    <g class="hw hw-salen" aria-hidden="true">
        <!-- Delante del tejado: salen volando cuando se levanta -->
        <g transform="translate(420, 200)"><use href="#hw-murcielago" class="hw-sale hw-sale-1" /></g>
        <g transform="translate(452, 178)"><use href="#hw-murcielago" class="hw-sale hw-sale-2" /></g>
        <g transform="translate(486, 204)"><use href="#hw-murcielago" class="hw-sale hw-sale-3" /></g>
        <g transform="translate(440, 214)"><use href="#hw-murcielago" class="hw-sale hw-sale-4" /></g>
    </g>
)}

{parte === 'arana' && (
    <g class="hw hw-arana-sitio" aria-hidden="true">
        <!-- Cuelga del alero, sube y baja -->
        <g class="hw-arana">
            <line x1="548" y1="234" x2="548" y2="276" class="hw-hilo" />
            <g class="hw-arana-baja"><g transform="translate(548, 280)">
                <path d="M -4,-2 L -11,-7 L -13,-12 M -4,0 L -12,-1 L -15,-5 M -4,2 L -11,5 L -13,10 M -3,4 L -8,9 L -9,14
                         M 4,-2 L 11,-7 L 13,-12 M 4,0 L 12,-1 L 15,-5 M 4,2 L 11,5 L 13,10 M 3,4 L 8,9 L 9,14" class="hw-patas" />
                <ellipse cx="0" cy="2" rx="5.5" ry="6.5" class="hw-arana-cuerpo" />
                <circle cx="0" cy="-5" r="3.5" class="hw-arana-cuerpo" />
                <circle cx="-1.3" cy="-5.5" r="0.9" class="hw-ojillo" />
                <circle cx="1.3" cy="-5.5" r="0.9" class="hw-ojillo" />
            </g></g>
        </g>
    </g>
)}

{parte === 'puerta' && (
    <g class="hw hw-dentro" aria-hidden="true">
        <!-- Detrás de la puerta: el hueco oscuro y quien espera dentro -->
        <path d="M 380,420 L 380,340 A 25 25 0 0 1 430,340 L 430,420 Z" class="hw-hueco" />
        <g clip-path="url(#hw-recorte-puerta)">
            <ellipse cx="400" cy="420" rx="30" ry="22" fill="url(#hw-luz-vela)" class="hw-hueco-luz" />
            <g class="hw-ojos-puerta">
                <ellipse cx="414" cy="364" rx="3.2" ry="4.2" />
                <ellipse cx="424" cy="364" rx="3.2" ry="4.2" />
            </g>
        </g>
    </g>
)}

{parte === 'ventana' && (
    <g class="hw hw-ventana" clip-path="url(#hw-recorte-ventana)" aria-hidden="true">
        <!-- Dentro del cristal: un fantasma que pasa al asomarte -->
        <g class="hw-fantasma-ventana">
            <path d="M 485,352 L 485,322 A 10 10 0 0 1 505,322 L 505,352 L 501.6,348 L 498.3,352 L 495,348 L 491.6,352 L 488.3,348 Z" class="hw-fantasma" />
            <ellipse cx="491.5" cy="324" rx="1.8" ry="2.6" class="hw-fantasma-ojo" />
            <ellipse cx="498.5" cy="324" rx="1.8" ry="2.6" class="hw-fantasma-ojo" />
            <ellipse cx="495" cy="332" rx="2.2" ry="3" class="hw-fantasma-ojo" />
        </g>
    </g>
)}

{parte === 'calabaza' && (
    <g class="hw hw-calabaza-sitio hw-calabaza-porche" aria-hidden="true">
        <!-- La calabaza del porche, contra la pared -->
        <g transform="translate(508, 404)">
            <circle r="34" fill="url(#hw-luz-vela)" class="hw-calabaza-luz" />
            <path d="M -1,-14 Q 0,-21 5,-22" class="hw-tallo" />
            <ellipse cx="-8" cy="0" rx="9.5" ry="13.5" class="hw-gajo" />
            <ellipse cx="8" cy="0" rx="9.5" ry="13.5" class="hw-gajo" />
            <ellipse cx="0" cy="0" rx="9" ry="14.5" class="hw-gajo" />
            <g class="hw-cara">
                <path d="M -9,-4 L -4,-4 L -6.5,-9 Z M 4,-4 L 9,-4 L 6.5,-9 Z" />
                <path d="M -10,3 L -6,7 L -3,4 L 0,8 L 3,4 L 6,7 L 10,3 L 7,10 L -7,10 Z" />
            </g>
        </g>
    </g>
)}

{parte === 'calabaza-botella' && (
    <g class="hw hw-calabaza-sitio hw-calabaza-botella" aria-hidden="true">
        <g transform="translate(202, 409) scale(0.78)">
            <circle r="30" fill="url(#hw-luz-vela)" class="hw-calabaza-luz" />
            <path d="M -1,-14 Q 0,-21 5,-22" class="hw-tallo" />
            <ellipse cx="-8" cy="0" rx="9.5" ry="13.5" class="hw-gajo" />
            <ellipse cx="8" cy="0" rx="9.5" ry="13.5" class="hw-gajo" />
            <ellipse cx="0" cy="0" rx="9" ry="14.5" class="hw-gajo" />
            <g class="hw-cara">
                <path d="M -8,-5 A 3 3 0 1 0 -3,-5 Z M 3,-5 A 3 3 0 1 0 8,-5 Z" />
                <path d="M -8,4 Q 0,12 8,4 Q 0,8 -8,4 Z" />
            </g>
        </g>
    </g>
)}

{parte === 'botella' && (
    <g class="hw hw-calavera" aria-hidden="true" transform="translate(245, 359)">
        <!-- La etiqueta de la botella: ahora es una pócima -->
        <path d="M -8,-2 A 8 8 0 1 1 8,-2 L 8,3 L 5,3 L 5,7 L -5,7 L -5,3 L -8,3 Z" />
        <circle cx="-3.3" cy="-2" r="2.2" class="hw-calavera-hueco" />
        <circle cx="3.3" cy="-2" r="2.2" class="hw-calavera-hueco" />
        <path d="M -1,3 L 0,1 L 1,3 Z" class="hw-calavera-hueco" />
        <path d="M -11,11 L 11,17 M 11,11 L -11,17" class="hw-calavera-huesos" />
    </g>
)}

{parte === 'burbujas' && (
    <g class="hw hw-burbujas" aria-hidden="true">
        <circle cx="294" cy="350" r="3" />
        <circle cx="304" cy="348" r="2.2" />
        <circle cx="299" cy="352" r="1.6" />
    </g>
)}

{parte === 'gato' && (
    <g class="hw hw-gato" aria-hidden="true">
        <!-- Un gato negro sentado en el taburete. Salta con él. -->
        <g class="hw-gato-cuerpo">
            <path d="M 792,375 Q 808,374 806,361 Q 805,352 811,349" class="hw-gato-cola" />
            <path d="M 768,376 Q 765,357 774,350 L 771,336 L 777.5,342 L 782.5,342 L 789,336 L 786,350 Q 795,357 792,376 Z" class="hw-gato-silueta" />
            <ellipse cx="776.5" cy="349" rx="1.9" ry="2.4" class="hw-gato-ojo" />
            <ellipse cx="783.5" cy="349" rx="1.9" ry="2.4" class="hw-gato-ojo" />
            <path d="M 772,352 L 765,351 M 772,354 L 765,355 M 788,352 L 795,351 M 788,354 L 795,355" class="hw-bigotes" />
        </g>
    </g>
)}

{parte === 'niebla' && (
    <g class="hw hw-niebla" aria-hidden="true" filter="url(#hw-desenfoque)">
        <ellipse cx="200" cy="418" rx="120" ry="12" class="hw-bruma hw-bruma-1" />
        <ellipse cx="460" cy="424" rx="170" ry="11" class="hw-bruma hw-bruma-2" />
        <ellipse cx="720" cy="418" rx="140" ry="13" class="hw-bruma hw-bruma-3" />
    </g>
)}

{parte === 'ticket' && (
    <div class="row hw hw-ticket-susto"><span>{t(H.ticketSusto, idioma)}</span> <span>{t(H.ticketGratis, idioma)}</span></div>
)}
