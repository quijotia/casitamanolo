---
// Las piezas del disfraz de Navidad que van dentro del dibujo de la casa (y
// alguna de otras páginas). Cada <Navidena parte="…" /> se pone en el sitio
// exacto del SVG donde tiene que quedar: delante o detrás de lo que toca, y
// dentro del grupo que se mueve con ella (la nieve y las luces del tejado,
// dentro del tejado que se levanta; la corona, dentro de la puerta).
//
// Fuera de Navidad no se ven: navidad.css las oculta todas (.nv).
import { t, type Idioma } from '../i18n/config';
import { textosNavidad as N } from './textos';

interface Props {
    parte:
        | 'defs' | 'cielo' | 'chimenea' | 'tejado' | 'atico' | 'salen'
        | 'puerta' | 'corona' | 'ventana' | 'arbol' | 'regalos' | 'botella'
        | 'burbujas' | 'gato' | 'muneco' | 'nieve-suelo' | 'ticket';
    idioma?: Idioma;
}

const { parte, idioma = 'es' } = Astro.props;

// La estrella de ocho puntas, con la de abajo más larga, como la de Belén
const estrella8 = 'M 0,-30 L 1.8,-4.2 L 9.2,-9.2 L 4.2,-1.8 L 24,0 L 4.2,1.8 L 9.2,9.2 L 1.8,4.2 L 0,42 L -1.8,4.2 L -9.2,9.2 L -4.2,1.8 L -24,0 L -4.2,-1.8 L -9.2,-9.2 L -1.8,-4.2 Z';
// Una estrella de cinco puntas de radio 10, centrada en el origen
const estrella5 = 'M 0,-10 L 2.5,-3.4 L 9.5,-3.1 L 4,1.3 L 5.9,8.1 L 0,4.2 L -5.9,8.1 L -4,1.3 L -9.5,-3.1 L -2.5,-3.4 Z';

// Nieve y luces del tejado, calculadas sobre sus dos pendientes
const nieveTejado = 'M 327.8,227.7 L 450,136.8 L 572.2,227.7 L 565.6,236.6 Q 556.1,233.5 552.8,230.1 Q 549.4,226.8 547.1,222.1 Q 544.7,217.4 539.6,216.4 Q 534.5,215.4 530.4,213 Q 526.3,210.6 524,205.8 Q 521.7,201.1 517,199.5 Q 512.4,197.8 508,195.8 Q 503.6,193.9 500.3,190.5 Q 496.9,187.1 494.5,182.6 Q 492,178 487.5,176.2 Q 482.9,174.5 477.3,174.2 Q 471.6,173.9 469.7,168.6 Q 467.8,163.4 464.8,159.5 Q 461.9,155.5 456.8,154.4 Q 451.8,153.4 450,153 Q 448,153 443.3,154.6 Q 438.6,156.2 436.3,160.9 Q 433.9,165.6 429.9,168.1 Q 425.9,170.6 420.8,171.6 Q 415.6,172.5 413.2,177.2 Q 410.8,181.8 407.5,185.2 Q 404.2,188.6 399.5,190.2 Q 394.8,191.8 390.1,193.3 Q 385.3,194.7 382.7,199.1 Q 380.1,203.5 377.8,208.2 Q 375.5,213 369.6,213 Q 363.7,213 359.6,215.3 Q 355.5,217.6 353.2,222.3 Q 350.8,227.1 347,229.8 Q 343.2,232.6 338.8,234.6 L 334.4,236.5 Z';
const cableTejado = 'M 356.6,233.2 Q 359.6,234.7 362.6,226.2 Q 371.4,224.7 380.1,213.2 Q 388.9,211.6 397.6,200.1 Q 406.4,198.6 415.1,187.1 Q 423.9,185.6 432.6,174.1 Q 441.3,175 450,166 Q 458.7,175 467.4,174.1 Q 476.1,185.6 484.9,187.1 Q 493.6,198.6 502.4,200.1 Q 511.1,211.6 519.9,213.2 Q 528.6,224.7 537.4,226.2 Q 540.4,233.7 543.4,233.2';
const bombillasTejado = [
    [362.6, 226.2], [380.1, 213.2], [397.6, 200.1], [415.1, 187.1], [432.6, 174.1], [450, 166],
    [467.4, 174.1], [484.9, 187.1], [502.4, 200.1], [519.9, 213.2], [537.4, 226.2],
];
// Carámbanos colgando del alero (largo de cada uno)
const carambanos = [6, 10, 5, 13, 7, 9, 4, 11, 6, 10, 5, 13, 7, 9, 4, 11, 6]
    .map((largo, i) => {
        const x = 338 + i * 14;
        return `M ${x - 2.4},233 L ${x},${233 + largo} L ${x + 2.4},233 Z`;
    })
    .join(' ');

// Un regalo: caja con cinta y lazo. x, y = esquina de arriba a la izquierda
const regalo = (x: number, y: number, ancho: number, alto: number, clase: string) => ({ x, y, ancho, alto, clase });
---

{parte === 'defs' && (
    <defs>
        <path id="nv-estrella5" d={estrella5} />
        <radialGradient id="nv-halo-estrella">
            <stop offset="0%" stop-color="#FFF4C7" stop-opacity="0.7" />
            <stop offset="35%" stop-color="#F2C14E" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#F2C14E" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="nv-luz-calida">
            <stop offset="0%" stop-color="#FFD98A" stop-opacity="0.65" />
            <stop offset="100%" stop-color="#FF9F43" stop-opacity="0" />
        </radialGradient>
        <clipPath id="nv-recorte-ventana">
            <rect x="470" y="300" width="50" height="50" />
        </clipPath>
        <clipPath id="nv-recorte-puerta">
            <path d="M 380,420 L 380,340 A 25 25 0 0 1 430,340 L 430,420 Z" />
        </clipPath>
    </defs>
)}

{parte === 'cielo' && (
    <g class="nv nv-cielo" aria-hidden="true">
        <!-- Estrellas: más que en Halloween, la noche de invierno es clara -->
        <g class="nv-estrellitas">
            {[[70, 210, 1.6], [150, 40, 1.3], [335, 60, 1.5], [372, 118, 1], [620, 52, 1.6], [690, 120, 1.1],
              [880, 60, 1.4], [860, 250, 1], [120, 300, 1.1], [600, 210, 1], [460, 40, 1.3], [20, 120, 1.3],
              [250, 30, 1], [780, 30, 1.2], [520, 95, 0.9], [205, 130, 1], [740, 190, 0.9], [300, 175, 0.8]]
              .map(([x, y, r], i) => <circle cx={x} cy={y} r={r} style={`--i:${i}`} />)}
        </g>

        <!-- La estrella grande: se puede tocar (el deseo va en el script) -->
        <g class="nv-estrella-sitio">
            <g class="nv-estrella" id="nv-estrella" role="button" tabindex="0" aria-label={t(N.estrella, idioma)}>
                <circle r="80" fill="url(#nv-halo-estrella)" class="nv-estrella-halo" />
                <path d={estrella8} class="nv-estrella-cuerpo" />
                <circle r="3.4" class="nv-estrella-centro" />
            </g>
        </g>

        <!-- El trineo, que cruza el cielo de vez en cuando -->
        <g class="nv-trineo-ruta">
            <g class="nv-trineo">
                <path d="M 92,-12 L 104,-26 M 98,-19 L 92,-27 M 101,-23 L 108,-29" class="nv-trineo-linea" />
                <path d="M 70,-12 L 82,-26 M 76,-19 L 70,-27 M 79,-23 L 86,-29" class="nv-trineo-linea" />
                <ellipse cx="88" cy="-6" rx="10" ry="4.6" class="nv-trineo-cuerpo" />
                <ellipse cx="66" cy="-6" rx="10" ry="4.6" class="nv-trineo-cuerpo" />
                <path d="M 96,-8 L 102,-14 L 106,-12 M 74,-8 L 80,-14 L 84,-12" class="nv-trineo-linea" />
                <path d="M 82,-3 L 80,6 M 94,-3 L 97,5 M 60,-3 L 58,6 M 72,-3 L 75,5" class="nv-trineo-linea" />
                <circle cx="106" cy="-12" r="1.6" class="nv-nariz" />
                <path d="M 38,-10 Q 50,-14 58,-7 M 38,-12 Q 60,-18 80,-8" class="nv-trineo-riendas" />
                <path d="M 0,0 L 30,0 Q 39,0 39,-9 L 39,-18 L 11,-18 L 7,-8 L 0,-8 Z" class="nv-trineo-cuerpo" />
                <path d="M -5,6 L 36,6 Q 45,6 45,-1" class="nv-trineo-linea" />
                <path d="M 6,0 L 6,6 M 30,0 L 30,6" class="nv-trineo-linea" />
                <circle cx="31" cy="-24" r="7" class="nv-trineo-saco" />
                <circle cx="20" cy="-23" r="4.2" class="nv-trineo-cuerpo" />
                <path d="M 15,-25 L 21,-34 L 25,-25 Z" class="nv-trineo-gorro" />
            </g>
        </g>
    </g>
)}

{parte === 'chimenea' && (
    <path class="nv nv-nieve-chimenea" aria-hidden="true"
          d="M 516,161 Q 516,154 524,155 Q 530,151 537,154 Q 545,151 552,156 Q 556,158 554,162 Q 553,165 549,163 Q 547,167 543,164 L 525,164 Q 521,167 519,164 Q 515,165 516,161 Z" />
)}

{parte === 'tejado' && (
    <g class="nv nv-tejado" aria-hidden="true">
        <path d={nieveTejado} class="nv-nieve" />
        <path d={carambanos} class="nv-carambano" />
        <path d={cableTejado} class="nv-cable" />
        {bombillasTejado.map(([x, y], i) => (
            <g transform={`translate(${x}, ${y + 2.6})`}>
                <rect x="-1.6" y="-3.8" width="3.2" height="2.4" class="nv-casquillo" />
                <ellipse rx="2.9" ry="3.8" class={`nv-bombilla nv-color-${i % 5}`} style={`--i:${i}`} />
            </g>
        ))}
    </g>
)}

{parte === 'atico' && (
    <g class="nv nv-atico" aria-hidden="true">
        <ellipse cx="450" cy="226" rx="105" ry="22" fill="url(#nv-luz-calida)" class="nv-atico-luz" />
        {[regalo(368, 213, 22, 20, 'nv-rojo'), regalo(392, 222, 14, 11, 'nv-verde'),
          regalo(508, 214, 20, 19, 'nv-verde'), regalo(492, 223, 13, 10, 'nv-oro')].map((r) => (
            <g class="nv-regalo">
                <rect x={r.x} y={r.y} width={r.ancho} height={r.alto} class={`nv-caja ${r.clase}`} />
                <path d={`M ${r.x + r.ancho / 2},${r.y} L ${r.x + r.ancho / 2},${r.y + r.alto} M ${r.x},${r.y + r.alto / 2} L ${r.x + r.ancho},${r.y + r.alto / 2}`} class="nv-cinta" />
                <path d={`M ${r.x + r.ancho / 2},${r.y} q -6,-6 -7,0 q 1,3 7,0 q 6,-6 7,0 q -1,3 -7,0`} class="nv-lazo" />
            </g>
        ))}
    </g>
)}

{parte === 'salen' && (
    <g class="nv nv-salen" aria-hidden="true">
        <!-- Delante del tejado: estrellas que salen volando cuando se levanta -->
        <g transform="translate(420, 205)"><use href="#nv-estrella5" class="nv-sale nv-sale-1" /></g>
        <g transform="translate(452, 182)"><use href="#nv-estrella5" class="nv-sale nv-sale-2" /></g>
        <g transform="translate(486, 206)"><use href="#nv-estrella5" class="nv-sale nv-sale-3" /></g>
        <g transform="translate(438, 218)"><use href="#nv-estrella5" class="nv-sale nv-sale-4" /></g>
        <g transform="translate(468, 220)"><use href="#nv-estrella5" class="nv-sale nv-sale-5" /></g>
    </g>
)}

{parte === 'puerta' && (
    <g class="nv nv-dentro" aria-hidden="true">
        <!-- Detrás de la puerta: el salón con la chimenea encendida -->
        <path d="M 380,420 L 380,340 A 25 25 0 0 1 430,340 L 430,420 Z" class="nv-hueco" />
        <g clip-path="url(#nv-recorte-puerta)">
            <ellipse cx="410" cy="420" rx="34" ry="30" fill="url(#nv-luz-calida)" class="nv-hueco-luz" />
            <g class="nv-arbolito-dentro">
                <path d="M 418,364 L 428,382 L 422,382 L 431,398 L 424,398 L 433,412 L 403,412 L 412,398 L 405,398 L 414,382 L 408,382 Z" class="nv-abeto" />
                <circle cx="414" cy="388" r="1.8" class="nv-color-0" />
                <circle cx="423" cy="394" r="1.8" class="nv-color-1" />
                <circle cx="413" cy="404" r="1.8" class="nv-color-3" />
                <circle cx="426" cy="406" r="1.8" class="nv-color-2" />
                <use href="#nv-estrella5" transform="translate(418, 362) scale(0.45)" class="nv-punta" />
            </g>
        </g>
    </g>
)}

{parte === 'corona' && (
    <g class="nv nv-corona" aria-hidden="true">
        <circle cx="405" cy="352" r="10" class="nv-corona-aro" />
        {[0, 40, 80, 120, 160, 200, 240, 280, 320].map((a) => (
            <ellipse cx="405" cy="342" rx="2.4" ry="4.6" class="nv-corona-hoja" transform={`rotate(${a} 405 352) rotate(30 405 342)`} />
        ))}
        <circle cx="398" cy="346" r="1.5" class="nv-baya" />
        <circle cx="413" cy="350" r="1.5" class="nv-baya" />
        <circle cx="402" cy="360" r="1.5" class="nv-baya" />
        <path d="M 405,361 q -7,-6 -8,1 q 2,3 8,-1 q 6,-6 8,1 q -2,3 -8,-1 M 405,361 l -4,8 M 405,361 l 4,8" class="nv-corona-lazo" />
    </g>
)}

{parte === 'ventana' && (
    <g class="nv nv-ventana" aria-hidden="true">
        <!-- Dentro: un árbol que se enciende al asomarte -->
        <g clip-path="url(#nv-recorte-ventana)">
            <path d="M 505,316 L 514,332 L 509,332 L 517,346 L 493,346 L 501,332 L 496,332 Z" class="nv-abeto nv-abeto-ventana" />
            <rect x="503" y="346" width="4" height="4" class="nv-tronco" />
            {[[503, 330, 0], [508, 338, 1], [499, 341, 2], [511, 344, 3], [505, 325, 4]].map(([x, y, c], i) => (
                <circle cx={x} cy={y} r="1.6" class={`nv-luz-ventana nv-color-${c}`} style={`--i:${i}`} />
            ))}
            <use href="#nv-estrella5" transform="translate(505, 315) scale(0.36)" class="nv-punta nv-punta-ventana" />
        </g>
        <!-- Fuera: nieve en el alféizar -->
        <path d="M 466,351 Q 470,345 478,348 Q 485,344 493,348 Q 501,344 509,348 Q 517,345 524,351 Z" class="nv-nieve" />
    </g>
)}

{parte === 'arbol' && (
    <g class="nv nv-arbol" aria-hidden="true">
        <!-- El árbol del jardín, a la derecha de la casa -->
        <rect x="586" y="404" width="12" height="16" class="nv-tronco" />
        <path d="M 592,318 L 610,346 L 601,346 L 616,372 L 606,372 L 621,404 L 563,404 L 578,372 L 568,372 L 583,346 L 574,346 Z" class="nv-abeto nv-abeto-jardin" />
        <path d="M 576,360 Q 592,368 608,356 M 572,388 Q 594,398 614,384" class="nv-espumillon" />
        {[[585, 340, 0], [600, 352, 1], [580, 366, 2], [596, 372, 3], [609, 380, 4], [575, 392, 1], [590, 396, 0], [606, 398, 2], [592, 334, 3]].map(([x, y, c], i) => (
            <circle cx={x} cy={y} r="2.6" class={`nv-bombilla nv-color-${c}`} style={`--i:${i + 3}`} />
        ))}
        <g transform="translate(592, 313)">
            <circle r="12" fill="url(#nv-halo-estrella)" class="nv-punta-halo" />
            <use href="#nv-estrella5" transform="scale(0.85)" class="nv-punta" />
        </g>
        <!-- Regalos al pie -->
        {[regalo(560, 406, 16, 14, 'nv-rojo'), regalo(604, 409, 14, 11, 'nv-oro'), regalo(616, 411, 9, 9, 'nv-verde')].map((r) => (
            <g class="nv-regalo">
                <rect x={r.x} y={r.y} width={r.ancho} height={r.alto} class={`nv-caja ${r.clase}`} />
                <path d={`M ${r.x + r.ancho / 2},${r.y} L ${r.x + r.ancho / 2},${r.y + r.alto} M ${r.x},${r.y + r.alto / 2} L ${r.x + r.ancho},${r.y + r.alto / 2}`} class="nv-cinta" />
                <path d={`M ${r.x + r.ancho / 2},${r.y} q -5,-5 -6,0 q 1,2.5 6,0 q 5,-5 6,0 q -1,2.5 -6,0`} class="nv-lazo" />
            </g>
        ))}
    </g>
)}

{parte === 'regalos' && (
    <g class="nv nv-regalos-botella" aria-hidden="true">
        {[regalo(188, 397, 23, 23, 'nv-rojo'), regalo(205, 381, 17, 16, 'nv-verde'), regalo(211, 406, 15, 14, 'nv-oro')].map((r) => (
            <g class="nv-regalo">
                <rect x={r.x} y={r.y} width={r.ancho} height={r.alto} class={`nv-caja ${r.clase}`} />
                <path d={`M ${r.x + r.ancho / 2},${r.y} L ${r.x + r.ancho / 2},${r.y + r.alto} M ${r.x},${r.y + r.alto / 2} L ${r.x + r.ancho},${r.y + r.alto / 2}`} class="nv-cinta" />
                <path d={`M ${r.x + r.ancho / 2},${r.y} q -6,-6 -7,0 q 1,3 7,0 q 6,-6 7,0 q -1,3 -7,0`} class="nv-lazo" />
            </g>
        ))}
    </g>
)}

{parte === 'botella' && (
    <g class="nv nv-cava" aria-hidden="true">
        <!-- Cava: papel dorado en el cuello y una estrella en la etiqueta -->
        <path d="M 239,238 L 251,238 L 251,264 Q 245,268 239,264 Z" class="nv-oro-papel" />
        <path d="M 239,256 L 251,252 M 239,262 L 251,258" class="nv-oro-raya" />
        <use href="#nv-estrella5" transform="translate(245, 358) scale(0.9)" class="nv-etiqueta-estrella" />
        <path d="M 234,372 L 256,372" class="nv-oro-raya" />
    </g>
)}

{parte === 'burbujas' && (
    <g class="nv nv-burbujas" aria-hidden="true">
        <circle cx="294" cy="352" r="2.2" />
        <circle cx="303" cy="350" r="1.6" />
        <circle cx="299" cy="354" r="1.3" />
        <circle cx="307" cy="355" r="1.1" />
        <circle cx="291" cy="356" r="1.4" />
    </g>
)}

{parte === 'gato' && (
    <g class="nv nv-gato" aria-hidden="true">
        <!-- Un gato negro con gorro de Papá Noel. Salta con el taburete -->
        <g class="nv-gato-cuerpo">
            <path d="M 792,375 Q 808,374 806,361 Q 805,352 811,349" class="nv-gato-cola" />
            <path d="M 768,376 Q 765,357 774,350 L 771,336 L 777.5,342 L 782.5,342 L 789,336 L 786,350 Q 795,357 792,376 Z" class="nv-gato-silueta" />
            <ellipse cx="776.5" cy="349" rx="1.9" ry="2.4" class="nv-gato-ojo" />
            <ellipse cx="783.5" cy="349" rx="1.9" ry="2.4" class="nv-gato-ojo" />
            <path d="M 772,352 L 765,351 M 772,354 L 765,355 M 788,352 L 795,351 M 788,354 L 795,355" class="nv-bigotes" />
            <g class="nv-gorro">
                <path d="M 771,341 Q 774,327 786,323 Q 795,321 799,331 Q 791,328 789,341 Z" class="nv-gorro-rojo" />
                <rect x="768.5" y="339.5" width="23" height="5" rx="2.5" class="nv-gorro-borde" />
                <circle cx="799.5" cy="332" r="3" class="nv-gorro-borde nv-pompon" />
            </g>
        </g>
    </g>
)}

{parte === 'muneco' && (
    <g class="nv nv-jardin" aria-hidden="true">
        <!-- El muñeco de nieve, a la izquierda -->
        <g class="nv-muneco">
            <path d="M 104,384 L 88,374 M 92,377 L 88,370 M 132,384 L 148,372 M 144,375 L 149,368" class="nv-rama" />
            <circle cx="118" cy="404" r="16" class="nv-bola-nieve" />
            <circle cx="118" cy="379" r="11.5" class="nv-bola-nieve" />
            <circle cx="118" cy="360" r="8.5" class="nv-bola-nieve" />
            <path d="M 108,368 Q 118,373 128,368 L 128,372 Q 118,377 108,372 Z M 124,371 L 129,384 L 124,384 Z" class="nv-bufanda" />
            <path d="M 109,353 L 127,353 M 112,353 L 112,341 L 124,341 L 124,353" class="nv-sombrero" />
            <circle cx="115" cy="358" r="1.2" class="nv-carbon" />
            <circle cx="121" cy="358" r="1.2" class="nv-carbon" />
            <path d="M 118,361 L 127,363 L 118,364 Z" class="nv-zanahoria" />
            <circle cx="118" cy="383" r="1.3" class="nv-carbon" />
            <circle cx="118" cy="398" r="1.3" class="nv-carbon" />
            <circle cx="118" cy="406" r="1.3" class="nv-carbon" />
        </g>
        <!-- Dos abetos nevados, a la derecha -->
        <g class="nv-abetitos">
            <path d="M 862,360 L 880,420 L 844,420 Z" class="nv-abeto" />
            <path d="M 862,360 L 868,380 Q 862,384 856,380 Z" class="nv-nieve" />
            <path d="M 888,382 L 900,420 L 876,420 Z" class="nv-abeto" />
            <path d="M 888,382 L 892,395 Q 888,398 884,395 Z" class="nv-nieve" />
        </g>
    </g>
)}

{parte === 'nieve-suelo' && (
    <path class="nv nv-nieve-suelo" aria-hidden="true"
          d="M 150,424 Q 160,414 182,417 Q 205,410 230,417 Q 262,412 290,418 Q 330,410 368,417 Q 405,412 440,418 Q 482,410 520,417 Q 560,411 600,417 Q 640,410 680,418 Q 720,412 760,417 Q 800,410 835,418 Q 846,420 850,424 Z" />
)}

{parte === 'ticket' && (
    <div class="row nv nv-ticket-regalo"><span>{t(N.ticketRegalo, idioma)}</span> <span>{t(N.ticketGratis, idioma)}</span></div>
)}
