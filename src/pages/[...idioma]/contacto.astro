---
// src/pages/contacto.astro
import Layout from '../../layouts/Layout.astro';
import { rutasDeIdioma, enlace, t, type Idioma } from '../../i18n/config';
import { textos } from '../../i18n/textos';
import { correo, whatsapp, enlaceWhatsapp } from '../../data/casa';
import Idiomas from '../../components/Idiomas.astro';
import Encantada from '../../halloween/Encantada.astro';

export function getStaticPaths() { return rutasDeIdioma(); }
const { idioma } = Astro.props as { idioma: Idioma };
const T = textos[idioma];
---

<Layout title={T.contacto.titulo} idioma={idioma} destino="/contacto">
    
    <main class="printer-room">
        
        <!-- Botón Volver -->
        <a href={enlace('/', idioma)} class="btn-volver">
            {T.comun.volverCasa}
        </a>

        <Idiomas idioma={idioma} destino="/contacto" />

        <!-- La ranura de la impresora por donde sale el ticket -->
        <div class="printer-slot"></div>

        <div class="ticket-wrapper">
            <article class="ticket">
                
                <!-- Encabezado del Local.
                     Aquí iban una dirección y un NIF inventados. Un ticket sin
                     dirección se lee como un estudio que trabaja por correo;
                     con una falsa se lee como otra cosa, y esta página se
                     manda a clientes. Cuando haya sede, vuelven aquí:
                     T.contacto.direccion y T.contacto.nif. -->
                <header class="ticket-header">
                    <h1>{T.contacto.casa}</h1>
                    <p>{T.contacto.sede}</p>
                </header>

                <!-- Metadatos (Generados dinámicamente) -->
                <div class="ticket-meta">
                    <div class="row"><span>{T.contacto.mesa}</span> <span>04</span></div>
                    <div class="row"><span>{T.contacto.fecha}</span> <span id="current-date">--/--/----</span></div>
                    <div class="row"><span>{T.contacto.hora}</span> <span id="current-time">--:--</span></div>
                    <div class="row"><span>{T.contacto.atendio}</span> <span>{T.contacto.camarero}</span></div>
                </div>

                <div class="divider"></div>

                <!-- El "Manifiesto" disfrazado de comanda -->
                <div class="ticket-items">
                    <div class="row font-bold mb-2"><span>{T.contacto.descripcion}</span> <span>{T.contacto.importe}</span></div>
                    <div class="row"><span>{T.contacto.items.briefing}</span> <span>0.00</span></div>
                    <div class="row"><span>{T.contacto.items.escucha}</span> <span>0.00</span></div>
                    <div class="row"><span>{T.contacto.items.tema}</span> <span>{T.contacto.invitacion}</span></div>
                    <div class="row"><span>{T.contacto.items.revisiones}</span> <span>{T.contacto.invitacion}</span></div>
                    <div class="row"><span>{T.contacto.items.mezcla}</span> <span>{T.contacto.invitacion}</span></div>
                    <!-- Solo en Halloween (src/halloween) -->
                    <Encantada parte="ticket" idioma={idioma} />
                </div>

                <div class="divider"></div>
                <div class="divider"></div>

                <!-- Formulario integrado en el ticket -->
                <div class="ticket-form-section">
                    <p class="form-instructions">{T.contacto.rellenar}</p>
                    
                    <form id="contact-form" class="ticket-form" action="https://formsubmit.co/infocasitamanolo@gmail.com" method="POST" data-astro-reload>
                        <input type="hidden" name="_subject" value={T.contacto.asunto} />
                        <!-- Trampa para robots: la gente no la ve y no la rellena;
                             los que la rellenan no son gente. FormSubmit tira el
                             envío si viene con algo. -->
                        <input type="text" name="_honey" class="trampa" tabindex="-1" autocomplete="off" aria-hidden="true" />
                        <input type="hidden" name="_template" value="table" />
                        <input type="hidden" name="Fecha_UTC" id="submission-date" value="" />
                        <div class="form-row">
                            <label for="name">{T.contacto.nombre}</label>
                            <input type="text" id="name" name="nombre" required autocomplete="name" maxlength="150" />
                        </div>
                        
                        <div class="form-row">
                            <label for="email">{T.contacto.email}</label>
                            <input type="email" id="email" name="email" required autocomplete="email" maxlength="254" />
                        </div>
                        
                        <div class="form-row-col">
                            <label for="message">{T.contacto.encargo}</label>
                            <textarea id="message" name="encargo" rows="3" required maxlength="10000"></textarea>
                        </div>

                        <!-- El Botón es un Sello de Caucho Rojo -->
                        <div class="stamp-container">
                            <button
                                type="submit"
                                class="stamp-btn"
                                id="submit-btn"
                                data-enviar={T.contacto.enviar}
                                data-enviando={T.contacto.enviando}
                                data-aviso={T.contacto.aviso}
                                data-error={T.contacto.errorEnvio}
                            >
                                {T.contacto.enviar}
                            </button>
                        </div>
                    </form>

                    <!-- El acuse: sale en el propio ticket, sin salir de la web -->
                    <div class="ticket-recibido" id="ticket-recibido" role="status" tabindex="-1" hidden>
                        <p class="recibido-sello">{T.contacto.recibidoSello}</p>
                        <p class="recibido-texto">{T.contacto.recibidoTexto}</p>
                    </div>

                    <p class="contact-direct">{T.contacto.tambien} <a href={`mailto:${correo}`}>{correo}</a>.</p>

                    <!-- Para quien no quiere rellenar nada: WhatsApp, con el mensaje ya empezado -->
                    <a
                        class="ticket-whatsapp"
                        href={enlaceWhatsapp(T.contacto.whatsappMensaje)}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${T.contacto.whatsappAria}: ${whatsapp.visible}`}
                    >
                        <svg class="ticket-whatsapp-icono" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.1a8.9 8.9 0 0 0-7.7 13.4L3.1 20.9l4.5-1.2A8.9 8.9 0 1 0 12 3.1z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                            <path d="M9.1 8c.3-.5.9-.5 1.2-.1l.9 1.3c.2.3.2.8-.1 1.1l-.5.5c.5 1 1.3 1.8 2.3 2.3l.5-.5c.3-.3.8-.3 1.1-.1l1.3.9c.4.3.4.9-.1 1.2-.8.6-1.9.8-2.9.3-1.7-.8-3.1-2.2-3.9-3.9-.5-1-.3-2.1.2-2.8z" fill="currentColor" />
                        </svg>
                        <span class="ticket-whatsapp-texto">
                            <strong>{T.contacto.whatsappPrisa}</strong>
                            <span>{whatsapp.visible}</span>
                        </span>
                    </a>
                </div>

                <div class="divider"></div>

                <!-- Pie del Ticket limpio -->
                <footer class="ticket-footer">
                    <p class="total">{T.contacto.total}</p>
                    <p class="thank-you">{T.contacto.gracias}</p>
                    <p class="thank-you">{T.contacto.web}</p>
                    <a href={enlace('/', idioma)} class="ticket-salida">{T.comun.volverCasita}</a>
                </footer>

            </article>
        </div>

        <!-- Only the provider can confirm a submission; do not simulate success. -->
        <div id="system-toast" class="system-toast" role="status" aria-live="polite"></div>

    </main>
</Layout>

<style>
    /* ========================================================
       1. VARIABLES Y ESTRUCTURA BASE
       ======================================================== */
    :root {
        --ink-dark: #11231E; 
        --paper-light: #F4F1EC; 
        --accent-red: #D74F42; 
        --thermal-blur: 0px 0px 1px rgba(17, 35, 30, 0.4);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body, html {
        width: 100%;
        height: 100%;
        background-color: var(--ink-dark);
        font-family: 'Space Mono', monospace;
    }

    .printer-room {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* El ticket sale un poco mas abajo: arriba estan los grifos */
        padding: 106px 20px 60px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Botón Volver. Va fijo sobre el ticket, que es blanco y ocupa el
       centro de la pantalla: sin chapa propia el texto desaparecía. */
    .btn-volver {
        position: fixed;
        top: 24px;
        left: 24px;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 999px;
        background: rgba(8, 17, 14, 0.92);
        border: 1px solid rgba(244, 241, 236, 0.35);
        color: var(--paper-light);
        text-decoration: none;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        transition: background-color 0.3s, color 0.3s, transform 0.3s;
        z-index: 100;
    }

    .btn-volver:hover, .btn-volver:focus-visible {
        background: var(--accent-red);
        color: var(--paper-light);
        transform: translateX(-4px);
    }

    /* Y otra salida al final del ticket, para quien llega abajo del todo */
    .ticket-salida {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: 18px;
        padding: 10px 16px;
        border: 1px dashed rgba(17, 35, 30, 0.45);
        color: var(--ink-dark);
        text-decoration: none;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
    }
    .ticket-salida:hover, .ticket-salida:focus-visible {
        border-style: solid;
        color: var(--accent-red);
        border-color: var(--accent-red);
    }

    /* ========================================================
       2. EL TICKET TÉRMICO
       ======================================================== */
    .printer-slot {
        position: absolute;
        top: 46px;
        width: 380px;
        height: 20px;
        background: #08110e;
        border-radius: 0 0 10px 10px;
        box-shadow: inset 0 10px 20px rgba(0,0,0,1);
        z-index: 50;
    }

    .ticket-wrapper {
        perspective: 1000px;
        margin-top: -60px;
    }

    .ticket {
        position: relative;
        width: 360px;
        background-color: var(--paper-light);
        color: var(--ink-dark);
        padding: 40px 30px;
        box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        text-shadow: var(--thermal-blur);
        animation: printOut 1.5s var(--ease-out) forwards;
        transform-origin: top center;
    }

    @keyframes printOut {
        0% { transform: translateY(-100%) rotateX(-10deg); opacity: 0; }
        100% { transform: translateY(20px) rotateX(0deg); opacity: 1; }
    }

    /* BORDES ZIG-ZAG */
    .ticket::before,
    .ticket::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 6px;
        background-size: 12px 100%;
    }

    .ticket::before {
        top: -6px;
        background-image: linear-gradient(135deg, var(--paper-light) 50%, transparent 50%),
                          linear-gradient(-135deg, var(--paper-light) 50%, transparent 50%);
        background-position: top left;
    }

    .ticket::after {
        bottom: -6px;
        background-image: linear-gradient(45deg, var(--paper-light) 50%, transparent 50%),
                          linear-gradient(-45deg, var(--paper-light) 50%, transparent 50%);
        background-position: bottom left;
    }

    /* ========================================================
       3. CONTENIDO DEL TICKET
       ======================================================== */
    .ticket-header {
        text-align: center;
        margin-bottom: 20px;
    }

    .ticket-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1.1;
        margin-bottom: 5px;
    }

    .ticket-header p {
        font-size: 0.75rem;
        line-height: 1.4;
    }

    .divider {
        border-top: 2px dashed var(--ink-dark);
        width: 100%;
        margin: 15px 0;
        opacity: 0.6;
    }

    .row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        line-height: 1.6;
    }

    .font-bold { font-weight: 700; }
    .mb-2 { margin-bottom: 8px; }

    /* ========================================================
       4. FORMULARIO INTEGRADO
       ======================================================== */
    .form-instructions {
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 15px;
        text-align: center;
    }

    .ticket-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    /* `hidden` esconde poniendo display:none, y un display puesto a mano le
       gana: sin esto, al enviarse el ticket se quedaban a la vez el
       formulario y el sello de recibido. */
    .ticket-form[hidden],
    .ticket-recibido[hidden] { display: none; }

    .form-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .form-row-col {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 5px;
    }

    .ticket-form label {
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .ticket-form input,
    .ticket-form textarea {
        flex-grow: 1;
        background: transparent;
        border: none;
        border-bottom: 2px dotted var(--ink-dark);
        color: var(--ink-dark);
        font-family: 'Space Mono', monospace;
        font-size: 0.85rem;
        padding: 2px 0;
        outline: none;
        resize: none;
        text-shadow: var(--thermal-blur);
        transition: border-color 0.3s;
    }

    .ticket-form textarea {
        background-image: linear-gradient(transparent, transparent 23px, var(--ink-dark) 24px);
        background-size: 100% 24px;
        line-height: 24px;
        border-bottom: none;
        padding-top: 0;
    }

    .ticket-form input:focus,
    .ticket-form textarea:focus {
        border-bottom-color: var(--accent-red);
    }

    /* EL SELLO (Botón Submit) */
    .stamp-container {
        display: flex;
        justify-content: center;
        margin-top: 30px;
        margin-bottom: 10px;
    }

    .stamp-btn {
        background: transparent;
        border: 3px solid var(--accent-red);
        color: var(--accent-red);
        font-family: 'Space Mono', monospace;
        font-size: 1.1rem;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        transform: rotate(-4deg);
        opacity: 0.8;
        transition: transform 0.1s, opacity 0.3s;
        text-shadow: none; 
    }

    .stamp-btn:hover {
        opacity: 1;
        transform: scale(1.05) rotate(-6deg);
    }

    .stamp-btn:active {
        transform: scale(0.95) rotate(-2deg);
    }

    .stamp-btn:disabled { opacity: 0.5; cursor: wait; }

    /* Fuera de la vista pero dentro del formulario */
    .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

    /* EL ACUSE DE RECIBO
       El mismo sello de caucho que el botón, pero ya estampado: cae sobre el
       ticket, rebota y se queda torcido, como cuando lo aprietas de verdad. */
    .ticket-recibido { text-align: center; margin-top: 34px; }
    .ticket-recibido:focus { outline: none; }

    .recibido-sello {
        display: inline-block;
        border: 3px solid var(--accent-red);
        color: var(--accent-red);
        font-family: 'Space Mono', monospace;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        padding: 10px 20px;
        border-radius: 4px;
        transform: rotate(-4deg);
        animation: sellar 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes sellar {
        0%   { transform: rotate(-15deg) scale(1.7); opacity: 0; }
        55%  { opacity: 1; }
        100% { transform: rotate(-4deg) scale(1); opacity: 1; }
    }

    .recibido-texto { margin-top: 20px; font-size: 0.8rem; line-height: 1.7; }

    /* Cuando el aviso trae malas noticias no puede seguir en verde */
    .system-toast.es-error { color: #ff9b8f; border-color: #5a2a24; }

    @media (prefers-reduced-motion: reduce) {
        .recibido-sello { animation: none; }
    }
    .contact-direct { margin-top: 20px; font-size: 0.8rem; line-height: 1.7; text-align: center; overflow-wrap: anywhere; }
    .contact-direct a { color: inherit; text-underline-offset: 3px; }

    /* WhatsApp: una casilla más del ticket, con el mismo trazado a puntos.
       El bocadillo es el de siempre para que se reconozca sin leer, pero en
       tinta de impresora; el verde de WhatsApp solo sale al pasar por encima. */
    .ticket-whatsapp {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 18px auto 0;
        padding: 10px 14px;
        border: 1px dashed rgba(17, 35, 30, 0.45);
        color: var(--ink-dark);
        text-decoration: none;
        transition: border-color 0.25s, color 0.25s;
    }
    .ticket-whatsapp-icono { width: 28px; height: 28px; flex: none; transition: color 0.25s; }
    .ticket-whatsapp-texto { display: flex; flex-direction: column; gap: 3px; text-align: left; }
    .ticket-whatsapp-texto strong { font-size: 0.68rem; letter-spacing: 0.06em; line-height: 1.35; }
    .ticket-whatsapp-texto span { font-size: 0.8rem; letter-spacing: 0.08em; }
    .ticket-whatsapp:hover,
    .ticket-whatsapp:focus-visible { border-style: solid; border-color: var(--ink-dark); }
    .ticket-whatsapp:hover .ticket-whatsapp-icono,
    .ticket-whatsapp:focus-visible .ticket-whatsapp-icono { color: #1f9d55; }

    /* ========================================================
       5. PIE DEL TICKET
       ======================================================== */
    .ticket-footer {
        text-align: center;
        margin-top: 15px;
    }

    .total {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .thank-you {
        font-size: 0.75rem;
        opacity: 0.7;
    }

    /* ========================================================
       6. SISTEMA DE NOTIFICACIÓN
       ======================================================== */
    .system-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: #08110e;
        color: #4ade80; 
        padding: 10px 20px;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        border: 1px solid #1a332a;
        opacity: 0;
        pointer-events: none;
        transition: all 0.4s var(--ease-out);
        z-index: 100;
        max-width: calc(100vw - 32px);
        text-align: center;
    }

    .system-toast.active {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    /* En el móvil el ticket ocupa el ancho entero: el botón se queda arriba
       a la izquierda y el papel sale un poco más abajo de la ranura para que
       no le tape la cabecera. */
    @media (max-width: 680px) {
        /* En el movil los grifos van abajo, asi que el ticket recupera su sitio */
        .printer-room { padding-top: 60px; }
        .printer-slot { top: 0; }

        .btn-volver {
            top: 16px;
            left: 16px;
            padding: 10px 14px;
            font-size: 0.64rem;
            letter-spacing: 0.14em;
        }

        .ticket-wrapper { margin-top: -6px; }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const dateElement = document.getElementById('current-date');
        const timeElement = document.getElementById('current-time');
        
        if (dateElement && timeElement) {
            const now = new Date();
            const local = document.documentElement.lang || 'es';
            dateElement.textContent = now.toLocaleDateString(local, { day: '2-digit', month: '2-digit', year: 'numeric' });
            timeElement.textContent = now.toLocaleTimeString(local, { hour: '2-digit', minute: '2-digit' });
        }

        const form = document.getElementById('contact-form') as HTMLFormElement;
        const toast = document.getElementById('system-toast');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const submissionDate = document.getElementById('submission-date') as HTMLInputElement | null;

        if (form && toast && submitBtn) {
            const lifetime = new AbortController();
            const options = { signal: lifetime.signal };
            const recibido = document.getElementById('ticket-recibido');
            // El «a rellenar por el cliente» se va con el formulario: sin él
            // debajo, esa línea se queda dando una instrucción imposible.
            const instrucciones = document.querySelector<HTMLElement>('.form-instructions');

            const resetSubmit = () => {
                submitBtn.disabled = false;
                submitBtn.textContent = submitBtn.dataset.enviar ?? '';
                toast.classList.remove('active', 'es-error');
                toast.textContent = '';
                // Si se vuelve atrás, el ticket está otra vez para rellenar
                form.hidden = false;
                if (instrucciones) instrucciones.hidden = false;
                if (recibido) recibido.hidden = true;
            };
            resetSubmit();

            const avisar = (texto: string, mal = false) => {
                toast.textContent = texto;
                toast.classList.toggle('es-error', mal);
                toast.classList.add('active');
            };

            form.addEventListener('submit', async (event) => {
                if (submitBtn.disabled) { event.preventDefault(); return; }
                if (submissionDate) submissionDate.value = new Date().toISOString();

                // Sin fetch no hay nada que interceptar: sigue el envío de toda
                // la vida, que funciona igual aunque no haya JavaScript.
                if (typeof fetch !== 'function') return;

                event.preventDefault();
                submitBtn.disabled = true;
                submitBtn.textContent = submitBtn.dataset.enviando ?? '';
                avisar(submitBtn.dataset.aviso ?? '');

                try {
                    // La misma dirección del formulario, pero por la puerta que
                    // contesta en vez de llevarte a su página.
                    const puerta = form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/');
                    const respuesta = await fetch(puerta, {
                        method: 'POST',
                        headers: { Accept: 'application/json' },
                        body: new FormData(form),
                    });
                    if (!respuesta.ok) throw new Error(String(respuesta.status));

                    // El proveedor devuelve success:"false" mientras el correo
                    // no esté confirmado: eso no es un envío, es un aviso.
                    const datos = await respuesta.json().catch(() => null);
                    if (datos && String(datos.success) === 'false') throw new Error('sin confirmar');

                    form.hidden = true;
                    if (instrucciones) instrucciones.hidden = true;
                    toast.classList.remove('active', 'es-error');
                    if (recibido) { recibido.hidden = false; recibido.focus(); }
                } catch {
                    submitBtn.disabled = false;
                    submitBtn.textContent = submitBtn.dataset.enviar ?? '';
                    avisar(submitBtn.dataset.error ?? '', true);
                }
            }, options);
            window.addEventListener('pageshow', resetSubmit, options);
            document.addEventListener('astro:before-swap', () => lifetime.abort(), { once: true, signal: lifetime.signal });
        }
    });
</script>
